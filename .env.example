# =========================
# Database
# =========================
DATABASE_URL="postgresql://user:password@localhost:5432/yup_education?schema=public"

# =========================
# NextAuth
# =========================
AUTH_SECRET="your-auth-secret-here"  # generate: openssl rand -base64 32

# Google OAuth (tuỳ chọn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =========================
# Sanity CMS
# =========================
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your-sanity-api-token"

# =========================
# Site
# =========================
NEXT_PUBLIC_SITE_URL="https://yup.edu.vn"

# =========================
# Google Analytics
# =========================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
